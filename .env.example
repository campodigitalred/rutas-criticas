# Copia este archivo a .env y ajusta los valores.
# docker compose lo carga automáticamente.

# Secreto para firmar/verificar los JWT (¡obligatorio cambiarlo en producción!).
CAMPO_JWT_SECRET=genera-una-clave-larga-y-aleatoria

# Asistente IA (opcional). Sin API key, el backend usa el generador heurístico offline.
CAMPO_LLM_API_KEY=
CAMPO_LLM_MODEL=gpt-4o-mini
